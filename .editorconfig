# EditorConfig is awesome: https://EditorConfig.org
# Checked by checklist-dev-editorconfig (editorconfig-checker).

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
quote_type = double
tab_width = 2
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
# indent_size explicitly unset (not just omitted: EditorConfig sections
# cascade, so leaving this out would still inherit indent_size=2 from
# [*] above). editorconfig-checker validates indentation as multiples of
# indent_size whenever both keys resolve to a value, and ordered-list
# continuation lines (e.g. under "1. ") naturally hang at 3 or 4 spaces,
# not 2. Enforcing it here would make every ordered list in this repo's
# own docs a violation, unrelated to the whitespace bugs this file
# exists to catch. Mirrors the library's own root .editorconfig.
indent_style = space
indent_size = unset
# max_line_length is off here on purpose: markdownlint's MD013 already
# enforces Markdown line length, and it has the exceptions that matter
# (tables: false, code_blocks: false, an inline disable comment for
# unwrappable tokens such as long URLs). editorconfig-checker has no
# such escape hatch, so leaving both tools enforcing the same rule meant
# the one without exceptions won. Mirrors the library's own root
# .editorconfig. (off, not 0: editorconfig-checker reads a literal 0 as
# "lines must be 0 characters long", not "unlimited".)
max_line_length = off
trim_trailing_whitespace = false

[*.py]
max_line_length = 100

[*.{bash,sh}]
indent_size = 2
quote_type = ignore

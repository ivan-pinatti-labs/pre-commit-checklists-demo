# EditorConfig is awesome: https://EditorConfig.org
# Checked by checklist-dev-editorconfig (editorconfig-checker).

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
quote_type = double
tab_width = 2
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
indent_style = space
indent_size = 2
max_line_length = 100
trim_trailing_whitespace = false

[*.py]
max_line_length = 100

[*.{bash,sh}]
indent_size = 2
quote_type = ignore

{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Dependabot handles the pre-commit-checklists rev: pin in
  // .pre-commit-config.yaml, every uses: pin under .github/workflows/, and
  // the pyyaml pin in requirements.txt; see dependabot.yml. Renovate exists
  // for exactly one gap that leaves: .tool-versions pins github-cli and
  // pre-commit via asdf, a file format neither Dependabot ecosystem here
  // reads. Renovate's built-in asdf manager already knows both tools and
  // watches .tool-versions by default, so no custom manager configuration
  // is needed beyond enabledManagers below.
  //
  // This repository also has a Dockerfile (`FROM python:3.12-slim`) that
  // neither bot manages, on purpose: Dependabot has no docker ecosystem
  // entry here and Renovate's dockerfile manager is not enabled below.
  // Unlike rsync-crypt's ALPINE_VERSION, there is no annotated pin or
  // custom regex manager anchoring this one, and it is this demo's fixture
  // for checklist-dev-docker's hadolint-docker hook rather than a
  // production base image with its own upgrade cadence. Wiring it up would
  // mean re-deriving the same Pin Only / cooldown reasoning
  // docs/MERGE_PIPELINE.md and dependabot.yml's pip block already spell out
  // for requirements.txt, for a surface this demo does not need automated.
  // Bumping the tag is a manual edit when there is a reason to.
  extends: ["config:recommended"],

  // Kept on despite the standing, never-resolving tracking issue it opens.
  // Without it, "Renovate found nothing to update" and "Renovate silently
  // stopped seeing your dependencies" look identical, and the dashboard is
  // the only place Renovate reports detection errors and rate-limited
  // updates.
  dependencyDashboard: true,

  timezone: "America/Toronto",

  // Daily, not Wednesday. A weekly schedule stacks on top of
  // minimumReleaseAge's 7 day floor below rather than overlapping it: a
  // release that misses its weekly slot by a day waits a full extra week,
  // pushing the effective floor to 14 days when 7 was intended. Checking
  // daily keeps the schedule's own period short enough that it cannot add
  // more than a day on top of that floor.
  //
  // Not scoped to a day the way Dependabot is, and this does not collide
  // with dependabot.yml's Wednesday slot in this repository: a Renovate
  // pin-only bump resolves `Review Verified` through
  // scripts/coderabbit-review-verdict.py's bot lane without CodeRabbit ever
  // being asked, so it consumes no review quota. The day-spreading recorded
  // in ivan-pinatti-labs/.github's docs/BOT_SCHEDULE.md is a Dependabot
  // concern only; see that document's "Cooling windows" and "Renovate runs
  // daily everywhere" sections for the full reasoning, not restated here.
  schedule: ["before 7am"],

  labels: ["dependencies"],
  commitMessagePrefix: "chore:",

  // Keep PR volume manageable so CI is not overwhelmed.
  prConcurrentLimit: 5,
  prHourlyLimit: 2,

  // The default deny. Overridden per update type by the first packageRules
  // entry below, which is the only place that grants it: an update type
  // this config has not thought about arrives unlabelled and waits for a
  // person rather than merging on the strength of a default nobody chose.
  automerge: false,

  // Dependabot owns pre-commit hook revs and github-actions pins;
  // requirements.txt is also Dependabot's (the pip ecosystem in
  // dependabot.yml), and the Dockerfile is deliberately unmanaged by either
  // bot (see the comment on extends: above). Restricting to asdf here
  // avoids Renovate opening a duplicate pull request for anything
  // Dependabot, or nobody, already owns.
  enabledManagers: ["asdf"],

  // A cooling window before an update is offered at all, mirroring
  // ivan-pinatti-labs/rsync-crypt's reasoning: `Pin Only` proves a diff
  // changed nothing but a version token, and says so in its own docstring,
  // but it cannot tell a good release from a backdoored one, because a
  // fresh supply chain attack has no advisory yet for any scanner to match.
  // Age is the only defence against that, and granting automerge above
  // without it would mean merging a release published minutes earlier,
  // unattended, with no person ever looking.
  //
  // Seven days, the same as the sibling repositories, because the reasoning
  // is about how long a compromised release typically takes to be spotted
  // and pulled, not about this repository's (much smaller) dependency
  // surface. The two asdf tool pins here (github-cli, pre-commit) carry no
  // materially different risk profile that would justify a shorter wait.
  minimumReleaseAge: "7 days",

  // Hold the pull request until the window is satisfied rather than opening
  // one that is not allowed to merge yet. Without this, minimumReleaseAge
  // still gates the merge, but Renovate opens the pull request immediately
  // regardless, so it would sit for up to seven days looking blocked for no
  // visible reason instead of not existing yet.
  internalChecksFilter: "strict",

  // The exception: a fix for a known vulnerability is not made safer by
  // aging, and null clears the inherited window for these updates only.
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },

  packageRules: [
    // What may merge without anyone looking, and the label that says so.
    //
    // First in the list on purpose: later rules win on any key they share
    // with an earlier one, and the group rule below sets a name and labels,
    // not automerge policy, so it cannot accidentally override this by
    // coming after it.
    //
    // The label is the whole point. bot-auto-merge.yml approves a Renovate
    // pull request only when it carries `automerge`, reading the label
    // rather than restating which update types are eligible, so the policy
    // lives here, once. `Pin Only` is the actual security gate behind that
    // trust: every changed line still has to be nothing but a version in a
    // pin position, checked line by line, before the label alone can do
    // anything; see docs/MERGE_PIPELINE.md.
    //
    // patch and minor only. Either asdf tool here (github-cli, pre-commit)
    // could in principle offer a major, which is exactly the case that
    // needs a person to check nothing else in this repository's tooling
    // assumes the old major's behavior.
    {
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      addLabels: ["automerge"],
    },
    {
      matchManagers: ["asdf"],
      groupName: "asdf tool versions",
      groupSlug: "asdf-tools",
      labels: ["dependencies", "tooling"],
    },
  ],
}

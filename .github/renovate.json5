{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Renovate is the sole dependency update bot in this repository.
  // .github/dependabot.yml is gone; Renovate's native managers now cover
  // every pin surface it used to own: the pre-commit-checklists rev: pin in
  // .pre-commit-config.yaml, every uses: pin under .github/workflows/, and
  // the pyyaml/pytest pins in requirements.txt and tests/requirements.txt.
  // Renovate already covered the one gap Dependabot could never reach on
  // its own: the development container's base image digest and the
  // pre-commit rev: pin. Renovate's built-in managers watch both by
  // default, so no custom manager configuration is needed beyond
  // enabledManagers below.
  //
  // The root Dockerfile (`FROM python:3.12-slim`) stays deliberately
  // unmanaged. Unlike rsync-crypt's ALPINE_VERSION, there is no annotated
  // pin or custom regex manager anchoring this one, and it is this demo's
  // fixture for checklist-dev-docker's hadolint-docker hook rather than a
  // production base image with its own upgrade cadence. Wiring it up would
  // mean re-deriving the same Pin Only / cooldown reasoning
  // docs/MERGE_PIPELINE.md already spells out for requirements.txt, for a
  // surface this demo does not need automated. Bumping the tag is a manual
  // edit when there is a reason to.
  //
  // Renovate's dockerfile manager is enabled below, so that exclusion is
  // enforced by scope rather than by leaving the manager off entirely: the
  // packageRules entry limits it to .devcontainer/Dockerfile, which pins the
  // development container's base image by digest and does need watching.
  extends: ["config:recommended"],

  // Kept on despite the standing, never-resolving tracking issue it opens.
  // Without it, "Renovate found nothing to update" and "Renovate silently
  // stopped seeing your dependencies" look identical, and the dashboard is
  // the only place Renovate reports detection errors and rate-limited
  // updates.
  dependencyDashboard: true,

  timezone: "America/Toronto",

  // Daily, not Wednesday. A weekly schedule stacks on top of
  // minimumReleaseAge's 7 day floor below rather than overlapping it: a
  // release that misses its weekly slot by a day waits a full extra week, so
  // the oldest a package could sit before merging was up to 14 days even
  // though 7 was the intended floor. The floor itself never moved:
  // minimumReleaseAge is seven days either way, and what a weekly window
  // stretched was the worst case, not the minimum. Checking daily keeps the
  // schedule's own period short enough that it cannot add more than a day on
  // top of that floor.
  //
  // Daily. A pin-only bump resolves `Review Verified` through
  // the shared review verdict's bot lane without CodeRabbit ever
  // being asked, so it consumes no review quota, which is why the
  // organization's per-repository day table was dropped on 2026-09-02 in
  // favour of checking daily everywhere. See ivan-pinatti-labs/.github's
  // README.md, "Dependency policy".
  schedule: ["before 7am"],

  // config:recommended extends :ignoreModulesAndTests, whose ignorePaths
  // include "**/tests/**" (meant for a vendored test fixture directory, not
  // this repository's own test suite), and ignorePaths is evaluated once
  // for the whole repository rather than per manager, so there is no way to
  // un-ignore tests/requirements.txt for pip_requirements alone. Confirmed
  // live with a dry-run=extract: with the inherited default left in place,
  // pip_requirements read requirements.txt but never tests/requirements.txt,
  // silently, the same gap this organization's own pilot migration on
  // docker-torrent-box-with-vpn also carries unnoticed (confirmed the same
  // way, against that repository's own checkout). ignorePaths is not
  // mergeable, so setting it here replaces the inherited array rather than
  // adding to it; the two entries kept are Renovate's own bare default
  // (node_modules, bower_components), neither of which exists in this
  // repository, kept anyway because there is no reason to drop them.
  // Re-verified after this change: pip_requirements now reads both
  // requirements.txt and tests/requirements.txt, with no other manager's
  // matches gaining or losing a file.
  ignorePaths: ["**/node_modules/**", "**/bower_components/**"],

  labels: ["dependencies"],
  commitMessagePrefix: "chore:",

  // Keep PR volume manageable so CI is not overwhelmed.
  prConcurrentLimit: 5,
  prHourlyLimit: 2,

  // The default deny. Overridden per update type by the first packageRules
  // entry below, which is the only place that grants it: an update type
  // this config has not thought about arrives unlabelled and waits for a
  // person rather than merging on the strength of a default nobody chose.
  automerge: false,

  // The pin surfaces this repository has (see .github/pin-only.yml for the
  // same list from the grading side). "dockerfile" is enabled but scoped: the packageRules
  // entry further down limits it to .devcontainer/Dockerfile, so it watches
  // the development container's base image digest and never reads the root
  // Dockerfile, which stays unmanaged for the reasons on extends: above.
  // Beyond that: "pre-commit"
  // watches .pre-commit-config.yaml's rev: pin, enabled explicitly below
  // since it ships disabled upstream; "github-actions" watches every
  // uses: pin under .github/workflows/; "pip_requirements" watches
  // requirements.txt and tests/requirements.txt; "custom.regex" watches the
  // development container base image digest. That last one is
  // the surface .github/pin-only.yml deliberately does not name
  // as a pin: a plugin change is code, and `Pin Only` sending it to a person
  // is the intended outcome.
  enabledManagers: [
    "pre-commit",
    "github-actions",
    "pip_requirements",
    "custom.regex",
    "dockerfile",
  ],

  // Off by default upstream ("not supported by the pre-commit maintainers
  // or community" per the manager's own warning, a statement about where
  // bug reports go rather than a reason to leave hook revisions unwatched).
  // Confirmed live with a dry-run=extract against this repository: with
  // "pre-commit" already sitting in enabledManagers above but this block
  // absent, the manager extracted nothing at all from
  // .pre-commit-config.yaml. enabledManagers only controls which managers
  // are allowed to run; it does not flip an individually-disabled manager
  // back on, and this is the fix.
  "pre-commit": {
    enabled: true,
  },

  // A cooling window before an update is offered at all, mirroring
  // ivan-pinatti-labs/rsync-crypt's reasoning: `Pin Only` proves a diff
  // changed nothing but a version token, and says so in its own docstring,
  // but it cannot tell a good release from a backdoored one, because a
  // fresh supply chain attack has no advisory yet for any scanner to match.
  // Age is the only defence against that, and granting automerge above
  // without it would mean merging a release published minutes earlier,
  // unattended, with no person ever looking.
  //
  // Seven days, the same as the sibling repositories, because the reasoning
  // is about how long a compromised release typically takes to be spotted
  // and pulled, not about this repository's (much smaller) dependency
  // surface. The pins here carry no
  // materially different risk profile that would justify a shorter wait.
  minimumReleaseAge: "7 days",

  // Hold the pull request until the window is satisfied rather than opening
  // one that is not allowed to merge yet. Without this, minimumReleaseAge
  // still gates the merge, but Renovate opens the pull request immediately
  // regardless, so it would sit for up to seven days looking blocked for no
  // visible reason instead of not existing yet.
  internalChecksFilter: "strict",

  // The exception: a fix for a known vulnerability is not made safer by
  // aging, and null clears the inherited window for these updates only.
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },

  packageRules: [
    // What may merge without anyone looking, and the label that says so.
    //
    // First in the list on purpose: later rules win on any key they share
    // with an earlier one, and the group rule below sets a name and labels,
    // not automerge policy, so it cannot accidentally override this by
    // coming after it.
    //
    // The label is the whole point. bot-auto-merge.yml approves a Renovate
    // pull request only when it carries `automerge`, reading the label
    // rather than restating which update types are eligible, so the policy
    // lives here, once. `Pin Only` is the actual security gate behind that
    // trust: every changed line still has to be nothing but a version in a
    // pin position, checked line by line, before the label alone can do
    // anything; see docs/MERGE_PIPELINE.md.
    //
    // patch and minor only, across every manager below. Any of them could in
    // principle offer a major, which is exactly the case that needs a
    // person to check nothing else in this repository's tooling assumes
    // the old major's behavior.
    {
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      addLabels: ["automerge"],
    },
    // The development container's base image, pinned by digest in
    // .devcontainer/Dockerfile. matchFileNames is what keeps the dockerfile
    // manager to that one file, which is what leaves the root Dockerfile
    // (`FROM python:3.12-slim`, the hadolint fixture) unwatched; see the
    // comment on extends: at the top of this file.
    //
    // Merged unattended. A digest update matches none of the automerge
    // grants above, which cover patch and minor only, so this rule grants
    // it itself. This is the
    // organization's own image, built by ivan-pinatti-labs/devcontainer-images,
    // and the quality gate lives there rather than in each consumer: that
    // repository ages its own upstream inputs through a seven day
    // minimumReleaseAge, sends Ubuntu minor and major moves to a
    // person, and only publishes from a reviewed merge to main. A digest
    // arriving here has therefore already passed that gate, and `Pin Only`
    // grades the `ARG BASE_IMAGE=<image>@sha256:<digest>` line (the shared
    // pin-only check's image_digest grammar), so the ordinary bot lane
    // approves it.
    // GHCR returns no release timestamp for a digest, so under Renovate's
    // default minimumReleaseAgeBehaviour (timestamp-required) the seven day
    // window above would hold every base image bump forever and, with
    // internalChecksFilter strict, never open the pull request at all.
    // Measured with a dry-run=full: "digest update of
    // ghcr.io/ivan-pinatti-labs/devcontainer-base has no releaseTimestamp to
    // age against". timestamp-optional lets the update be offered; the seven
    // day window is applied upstream instead, in devcontainer-images, where the
    // image's own inputs are aged before anything is published.
    {
      matchManagers: ["dockerfile"],
      matchFileNames: [".devcontainer/Dockerfile"],
      groupName: "development container base image",
      groupSlug: "devcontainer-base",
      labels: ["dependencies", "tooling"],
      minimumReleaseAgeBehaviour: "timestamp-optional",
      automerge: true,
      addLabels: ["automerge"],
    },
    // The root Dockerfile stays unmanaged, and this is what enforces it.
    // Enabling the dockerfile manager above makes Renovate extract every
    // Dockerfile in the repository, this one included: confirmed with a
    // dry-run=extract, which read `FROM python:3.12-slim` and would have
    // proposed a newer tag for the hadolint fixture. matchFileNames on the
    // rule above only scopes grouping and automerge policy, it does not stop
    // extraction, so the exclusion needs saying outright here.
    {
      matchManagers: ["dockerfile"],
      matchFileNames: ["Dockerfile"],
      enabled: false,
    },
    // One pull request per ecosystem, matching the shape dependabot.yml
    // used to give these two before it was deleted (groups: pre-commit-hooks
    // / github-actions, both patterns: ["*"]). addLabels, not labels: labels
    // replaces the top level labels array outright (confirmed against
    // Renovate's own configuration-options documentation), and the point
    // here is to add the ecosystem-specific label on top of `dependencies`
    // every Renovate pull request already carries, matching what a grouped
    // Dependabot pull request for either ecosystem used to carry
    // (dependencies, pre-commit / dependencies, github-actions).
    {
      matchManagers: ["pre-commit"],
      groupName: "pre-commit hooks",
      groupSlug: "pre-commit-hooks",
      addLabels: ["pre-commit"],
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      groupSlug: "github-actions",
      addLabels: ["github-actions"],
    },
    // The github-actions manager extracts more than uses: pins by default:
    // confirmed live with a dry-run=extract against this repository, it also
    // proposes updates for pull-request.yml's runs-on: ubuntu-24.04
    // (depType github-runner) and the python-version: "3.12" passed to
    // actions/setup-python's with: (depType uses-with). Dependabot's
    // github-actions ecosystem never watched either; it bumps uses: pins
    // only. Disabled here so this migration hands Renovate exactly the
    // scope Dependabot had, not a wider one nobody has reviewed the
    // implications of. Nothing downstream would have merged one of these
    // unattended regardless, since the shared pin-only check's
    // rev_pin and action_sha grammars do not match a runner OS or a with:
    // input and Pin Only would have refused any such diff, but this rule
    // stops the pull request from being opened at all rather than relying
    // on that fallback for something that was never in scope.
    {
      matchManagers: ["github-actions"],
      matchDepTypes: ["github-runner", "uses-with"],
      enabled: false,
    },
    // pip_requirements reads both requirements.txt and tests/requirements.txt
    // by its own default file match, with no directory scoping needed
    // (confirmed with a dry-run=extract). Left ungrouped, unlike the two
    // rules above: dependabot.yml never grouped its two pip ecosystem
    // blocks either (no groups: key on either one), each ungrouped because
    // there was exactly one dependency per file, so an ungrouped rule here
    // is the same shape carried forward, not a behavior change. Only the
    // label is added on top of the default one-pull-request-per-dependency
    // shape, matching what either Dependabot pip block used to add
    // (dependencies, python).
    {
      matchManagers: ["pip_requirements"],
      addLabels: ["python"],
    },
  ],

}
